<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 김현석 / 2018.02.26 -->
<simple-methods xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns="http://ofbiz.apache.org/Simple-Method" xsi:schemaLocation="http://ofbiz.apache.org/Simple-Method http://ofbiz.apache.org/dtds/simple-methods.xsd">

	<!-- FRHR_<mainAction> 또는 FRHR_ADMIN 보유 여부 확인. 시드에는 VIEW/ADMIN 만 있으므로 CREATE/UPDATE/DELETE 는 ADMIN 필요 -->
	<!-- 법개정 시 같이 수정 필요!! -->
	<simple-method method-name="frHrPermissionCheck" short-description="FRHR 권한 확인">
		<set field="primaryPermission" value="FRHR"/>
		<call-simple-method method-name="genericBasePermissionCheck" xml-resource="component://common/minilang/permission/CommonPermissionServices.xml"/>
	</simple-method>

	<!-- 20231207 한예린 기존 로직 백업 -->
	<simple-method method-name="frHrPermissionCheckBak" short-description="FRHR 권한 확인">
		<set field="primaryPermission" value="FRHR"/>
		<call-simple-method method-name="genericBasePermissionCheck" xml-resource="component://common/minilang/permission/CommonPermissionServices.xml"/>
	</simple-method>

	<!-- 2019.08.06 윤서진 신규 (기존 유지) -->
	<simple-method method-name="frHrPermissionCheck2" short-description="FRHR 권한 확인">
		<set field="primaryPermission" value="FRHR"/>
		<call-simple-method method-name="genericBasePermissionCheck" xml-resource="component://common/minilang/permission/CommonPermissionServices.xml"/>
	</simple-method>

	<!-- 20240329 한예린 백업 -->
	<simple-method method-name="frHrPermissionCheck2_Bak" short-description="FRHR 권한 확인">
		<set field="primaryPermission" value="FRHR"/>
		<call-simple-method method-name="genericBasePermissionCheck" xml-resource="component://common/minilang/permission/CommonPermissionServices.xml"/>
	</simple-method>
</simple-methods>
