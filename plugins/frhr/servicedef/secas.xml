<service-eca xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/service-eca.xsd">
    <!-- 퇴사 처리 후 OFBiz Employment 종료 -->
    <eca service="processFrRetire" event="commit">
        <action service="expireFrEmployment" mode="sync"/>
    </eca>
    <!-- 연차 승인 시 OFBiz EmplLeave 에도 등록 -->
    <eca service="approveFrLeaveUse" event="commit">
        <action service="syncFrLeaveToEmplLeave" mode="sync"/>
    </eca>
</service-eca>
