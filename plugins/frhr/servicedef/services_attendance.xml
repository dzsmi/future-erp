<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 박준영 / 2018.03.26 -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">
    <description>FutureRetail HR Services - 근태</description>
    <vendor>OpenBridge Systems</vendor>
    <version>1.0</version>

    <service name="createFrAttendance" engine="simple"
            location="component://frhr/minilang/FrAttendanceServices.xml" invoke="createFrAttendance" auth="true">
        <description>근태 등록 (출퇴근 시각으로 근무시간/연장시간 계산)</description>
        <permission-service service-name="frHrPermissionCheck" main-action="CREATE"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="pk" optional="false"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="nonpk" optional="true">
            <exclude field-name="workHours"/>
            <exclude field-name="overtimeHours"/>
        </auto-attributes>
        <override name="attendTypeId" optional="false"/>
    </service>

    <!-- 20210716 정해인 기존 로직 백업 -->
    <service name="createFrAttendanceBak" engine="simple"
            location="component://frhr/minilang/FrAttendanceServices.xml" invoke="createFrAttendance" auth="true">
        <description>근태 등록 (출퇴근 시각으로 근무시간/연장시간 계산)</description>
        <permission-service service-name="frHrPermissionCheck" main-action="CREATE"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="pk" optional="false"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="nonpk" optional="true">
            <exclude field-name="workHours"/>
            <exclude field-name="overtimeHours"/>
        </auto-attributes>
        <override name="attendTypeId" optional="false"/>
    </service>

    <!-- 2021.06.17 송태호 백업 -->
    <service name="createFrAttendanceLegacy" engine="simple"
            location="component://frhr/minilang/FrAttendanceServices.xml" invoke="createFrAttendance" auth="true">
        <description>근태 등록 (출퇴근 시각으로 근무시간/연장시간 계산)</description>
        <permission-service service-name="frHrPermissionCheck" main-action="CREATE"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="pk" optional="false"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="nonpk" optional="true">
            <exclude field-name="workHours"/>
            <exclude field-name="overtimeHours"/>
        </auto-attributes>
        <override name="attendTypeId" optional="false"/>
    </service>
    <service name="updateFrAttendance" engine="simple"
            location="component://frhr/minilang/FrAttendanceServices.xml" invoke="updateFrAttendance" auth="true">
        <description>근태 수정 (근무시간/연장시간 재계산)</description>
        <permission-service service-name="frHrPermissionCheck" main-action="UPDATE"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="pk" optional="false"/>
        <auto-attributes entity-name="FrAttendance" mode="IN" include="nonpk" optional="true">
            <exclude field-name="workHours"/>
            <exclude field-name="overtimeHours"/>
        </auto-attributes>
    </service>
    <service name="deleteFrAttendance" engine="entity-auto" default-entity-name="FrAttendance" invoke="delete" auth="true">
        <description>근태 삭제</description>
        <permission-service service-name="frHrPermissionCheck" main-action="DELETE"/>
        <auto-attributes mode="IN" include="pk" optional="false"/>
    </service>

    <!-- 2021.05.04 송태호 테스트용 -->
    <service name="deleteFrAttendanceOld" engine="entity-auto" default-entity-name="FrAttendance" invoke="delete" auth="true">
        <description>근태 삭제</description>
        <permission-service service-name="frHrPermissionCheck" main-action="DELETE"/>
        <auto-attributes mode="IN" include="pk" optional="false"/>
    </service>
</services>
