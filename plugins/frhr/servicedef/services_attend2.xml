<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">
  <description>근태2 - 주52시간</description>
  <version>2.0</version>

  <!-- 출퇴근 -->
  <service name="saveAttend2" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2Services.groovy" invoke="saveAttend2" auth="true">
    <description>출퇴근 저장 (근무/연장/휴일 시간 계산)</description>
    <attribute name="att2Id" type="String" mode="INOUT" optional="true"/>
    <attribute name="partyId" type="String" mode="IN" optional="false"/>
    <attribute name="attDate" type="java.sql.Date" mode="IN" optional="false"/>
    <attribute name="inTime" type="Timestamp" mode="IN" optional="true"/>
    <attribute name="outTime" type="Timestamp" mode="IN" optional="true"/>
    <attribute name="holidayYn" type="String" mode="IN" optional="true"/>
    <attribute name="att2Type" type="String" mode="IN" optional="true"/>
    <attribute name="memo" type="String" mode="IN" optional="true"/>
  </service>

  <!-- 연장근로 신청 -->
  <service name="requestOt2" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2Services.groovy" invoke="requestOt2" auth="true">
    <description>연장근로 신청 - 주 12시간 초과 체크</description>
    <attribute name="partyId" type="String" mode="IN" optional="false"/>
    <attribute name="otDate" type="java.sql.Date" mode="IN" optional="false"/>
    <attribute name="startTime" type="Timestamp" mode="IN" optional="false"/>
    <attribute name="endTime" type="Timestamp" mode="IN" optional="false"/>
    <attribute name="holidayYn" type="String" mode="IN" optional="true"/>
    <attribute name="reason" type="String" mode="IN" optional="true"/>
    <attribute name="otReqId" type="String" mode="OUT" optional="true"/>
    <attribute name="weekOtHr" type="BigDecimal" mode="OUT" optional="true"/>
  </service>
  <service name="cancelOt2" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2Services.groovy" invoke="cancelOt2" auth="true">
    <attribute name="otReqId" type="String" mode="IN" optional="false"/>
  </service>

  <!-- 승인 -->
  <service name="approveOt2" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2Services.groovy" invoke="approveOt2" auth="true">
    <description>연장근로 승인/반려</description>
    <permission-service service-name="frHrPermissionCheck" main-action="UPDATE"/>
    <attribute name="otReqId" type="String" mode="IN" optional="false"/>
    <attribute name="reqStatus" type="String" mode="IN" optional="false"><description>APPR / REJ</description></attribute>
  </service>

  <!-- 재택근무 -->
  <service name="requestWfh2" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2Services.groovy" invoke="requestWfh2" auth="true">
    <description>재택근무 신청</description>
    <attribute name="partyId" type="String" mode="IN" optional="false"/>
    <attribute name="fromDate" type="java.sql.Date" mode="IN" optional="false"/>
    <attribute name="thruDate" type="java.sql.Date" mode="IN" optional="false"/>
    <attribute name="workPlace" type="String" mode="IN" optional="true"/>
    <attribute name="reason" type="String" mode="IN" optional="true"/>
    <attribute name="wfhReqId" type="String" mode="OUT" optional="true"/>
  </service>
  <service name="approveWfh2" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2Services.groovy" invoke="approveWfh2" auth="true">
    <description>연장근로 승인/반려</description>
    <permission-service service-name="frHrPermissionCheck" main-action="UPDATE"/>
    <attribute name="wfhReqId" type="String" mode="IN" optional="false"/>
    <attribute name="reqStatus" type="String" mode="IN" optional="false"><description>APPR / REJ</description></attribute>
  </service>

  <!-- 월 근태 마감 (매월 1일 04시, FrHrAttend2JobData.xml) -->
  <service name="closeAttend2Month" engine="groovy" location="component://frhr/groovyScripts/attend2/Attend2CloseBatch.groovy" invoke="closeAttend2Month" auth="true" transaction-timeout="1800">
    <description>월 근태 마감 - 연장/휴일근로 집계, 수당 계산</description>
    <attribute name="closeYm" type="String" mode="IN" optional="true"><description>yyyyMM, 없으면 전월</description></attribute>
    <attribute name="partyId" type="String" mode="IN" optional="true"/>
    <attribute name="closeCount" type="Integer" mode="OUT" optional="true"/>
  </service>
</services>
