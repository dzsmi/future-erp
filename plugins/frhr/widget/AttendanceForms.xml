  수정이력
    2020.12.22  홍성민  근태 현업 요청 반영
-->
<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">
    <form name="FindFrAttendance" type="single" target="FindFrAttendance" default-entity-name="FrAttendance"
            header-row-style="header-row" default-table-style="basic-table">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="partyId" title="${uiLabelMap.FrHrEmployee}"><lookup target-form-name="LookupPerson"/></field>
        <field name="workDate" title="${uiLabelMap.FrHrWorkDate}"><date-find type="date"/></field>
        <field name="attendTypeId" title="${uiLabelMap.FrHrAttendType}">
            <drop-down allow-empty="true">
                <entity-options entity-name="Enumeration" key-field-name="enumId" description="${description}">
                    <entity-constraint name="enumTypeId" value="FR_ATTEND_TYPE"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit"><submit button-type="button"/></field>
    </form>

    <form name="ListFrAttendance" type="list" list-name="listIt" paginate-target="FindFrAttendance" default-entity-name="FrAttendance"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="FrAttendance"/>
                <field-map field-name="orderBy" value="-workDate|partyId"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <field name="workDate" title="${uiLabelMap.FrHrWorkDate}"><display/></field>
        <field name="partyId" title="${uiLabelMap.FrHrEmployee}">
            <display-entity entity-name="Person" description="${lastName}${firstName}"/>
        </field>
        <field name="attendTypeId" title="${uiLabelMap.FrHrAttendType}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="checkInTime" title="${uiLabelMap.FrHrCheckIn}"><display/></field>
        <field name="checkOutTime" title="${uiLabelMap.FrHrCheckOut}"><display/></field>
        <field name="workHours" title="${uiLabelMap.FrHrWorkHours}"><display/></field>
        <field name="overtimeHours" title="${uiLabelMap.FrHrOvertimeHours}"><display/></field>
        <field name="remarks" title="${uiLabelMap.CommonRemarks}"><display/></field>
        <field name="editLink" title=" " widget-style="buttontext">
            <hyperlink description="${uiLabelMap.CommonEdit}" target="EditFrAttendance">
                <parameter param-name="partyId"/>
                <parameter param-name="workDate"/>
            </hyperlink>
        </field>
        <field name="deleteLink" title=" " widget-style="buttontext">
            <hyperlink description="${uiLabelMap.CommonDelete}" target="deleteFrAttendance" link-type="hidden-form" request-confirmation="true">
                <parameter param-name="partyId"/>
                <parameter param-name="workDate"/>
            </hyperlink>
        </field>
    </form>

    <form name="EditFrAttendance" type="single" target="updateFrAttendance" default-map-name="attendance"
            header-row-style="header-row" default-table-style="basic-table">
        <alt-target use-when="attendance==null" target="createFrAttendance"/>
        <field name="partyId" use-when="attendance==null" title="${uiLabelMap.FrHrEmployee}" required-field="true"><lookup target-form-name="LookupPerson"/></field>
        <field name="partyId" use-when="attendance!=null" title="${uiLabelMap.FrHrEmployee}"><display/></field>
        <field name="workDate" use-when="attendance==null" title="${uiLabelMap.FrHrWorkDate}" required-field="true"><date-time type="date"/></field>
        <field name="workDate" use-when="attendance!=null" title="${uiLabelMap.FrHrWorkDate}"><display/></field>
        <field name="attendTypeId" title="${uiLabelMap.FrHrAttendType}" required-field="true">
            <drop-down allow-empty="false" no-current-selected-key="FRAT_NORMAL">
                <entity-options entity-name="Enumeration" key-field-name="enumId" description="${description}">
                    <entity-constraint name="enumTypeId" value="FR_ATTEND_TYPE"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="checkInTime" title="${uiLabelMap.FrHrCheckIn}"><date-time type="timestamp"/></field>
        <field name="checkOutTime" title="${uiLabelMap.FrHrCheckOut}"><date-time type="timestamp"/></field>
        <field name="workHours" use-when="attendance!=null" title="${uiLabelMap.FrHrWorkHours}"><display/></field>
        <field name="overtimeHours" use-when="attendance!=null" title="${uiLabelMap.FrHrOvertimeHours}"><display/></field>
        <field name="remarks" title="${uiLabelMap.CommonRemarks}"><text size="60"/></field>
        <field name="submitButton" use-when="attendance==null" title="${uiLabelMap.CommonCreate}" widget-style="smallSubmit"><submit button-type="button"/></field>
        <field name="submitButton" use-when="attendance!=null" title="${uiLabelMap.CommonUpdate}" widget-style="smallSubmit"><submit button-type="button"/></field>
    </form>
</forms>
