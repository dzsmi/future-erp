<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 김현석 / 2018.02.21 -->
<entity-engine-xml>
    <!-- 재경 플러그인 권한
         FRACCT_VIEW  : 현업 사용자 (전표 작성/상신, 조회)
         FRACCT_ADMIN : 재경팀 (결재, 결산 마감, 세금계산서, 지급 관리) -->
    <SecurityPermission description="재경 조회 및 전표 작성/상신" permissionId="FRACCT_VIEW"/>
    <SecurityPermission description="재경 전체 관리 (결재/마감/세금계산서/지급)" permissionId="FRACCT_ADMIN"/>

    <SecurityGroup groupId="FRACCT_USER" description="재경 - 현업 사용자"/>
    <SecurityGroup groupId="FRACCT_ADMIN" description="재경 - 재경팀"/>

    <SecurityGroupPermission groupId="FRACCT_USER" permissionId="OFBTOOLS_VIEW" fromDate="2018-02-21 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_USER" permissionId="FRACCT_VIEW" fromDate="2018-02-21 00:00:00.0"/>

    <SecurityGroupPermission groupId="FRACCT_ADMIN" permissionId="OFBTOOLS_VIEW" fromDate="2018-02-21 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_ADMIN" permissionId="FRACCT_VIEW" fromDate="2018-02-21 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_ADMIN" permissionId="FRACCT_ADMIN" fromDate="2018-02-21 00:00:00.0"/>
    <!-- 전표 최종 승인 시 코어 createAcctgTrans / createAcctgTransEntry 호출 권한 -->
    <SecurityGroupPermission groupId="FRACCT_ADMIN" permissionId="ACCTG_ATX_CREATE" fromDate="2018-02-21 00:00:00.0"/>

    <SecurityGroupPermission groupId="SUPER" permissionId="FRACCT_ADMIN" fromDate="2018-02-21 00:00:00.0"/>

    <!-- 2021.09.27 정해인 결산 마감 해제 권한 (재경팀장/결산 담당)
         FRACCT_CLOSE_ADMIN : 마감 해제 + 마감월 전표 입력/수정 가능 (마감 체크 ECA 통과) -->
    <SecurityPermission description="재경 결산 마감 해제 및 마감월 전표 처리" permissionId="FRACCT_CLOSE_ADMIN"/>
    <SecurityGroup groupId="FRACCT_CLOSE_ADMIN" description="재경 - 결산 마감 관리자"/>
    <SecurityGroupPermission groupId="FRACCT_CLOSE_ADMIN" permissionId="OFBTOOLS_VIEW" fromDate="2021-09-27 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_CLOSE_ADMIN" permissionId="FRACCT_VIEW" fromDate="2021-09-27 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_CLOSE_ADMIN" permissionId="FRACCT_ADMIN" fromDate="2021-09-27 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_CLOSE_ADMIN" permissionId="FRACCT_CLOSE_ADMIN" fromDate="2021-09-27 00:00:00.0"/>
    <SecurityGroupPermission groupId="FRACCT_CLOSE_ADMIN" permissionId="ACCTG_ATX_CREATE" fromDate="2021-09-27 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPER" permissionId="FRACCT_CLOSE_ADMIN" fromDate="2021-09-27 00:00:00.0"/>
</entity-engine-xml>
