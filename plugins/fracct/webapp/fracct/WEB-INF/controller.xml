<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 이소라 / 2018.05.14 -->
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf" xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">
    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <include location="component://party/webapp/partymgr/WEB-INF/controller.xml"/>
    <description>FutureRetail Accounting (fracct) Site Configuration File</description>

    <!-- Request Mappings -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- ================ 전표 ================ -->
    <request-map uri="FindFrSlip">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrSlip"/>
    </request-map>

    <!-- 2019.04.01 윤서진 테스트용 -->
    <request-map uri="FindFrSlipOld">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrSlip"/>
    </request-map>
    <!-- 2019.05.13 정해인 전표 엑셀 업로드 -->
    <request-map uri="FrSlipUpload">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FrSlipUpload"/>
    </request-map>
    <request-map uri="uploadFrSlipCsv">
        <security https="true" auth="true"/>
        <event type="service" invoke="uploadFrSlipCsv"/>
        <response name="success" type="view" value="FindFrSlip"/>
        <response name="error" type="view" value="FrSlipUpload"/>
    </request-map>
    <request-map uri="EditFrSlip">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="EditFrSlip"/>
    </request-map>
    <request-map uri="createFrSlip">
        <security https="true" auth="true"/>
        <event type="service" invoke="createFrSlip"/>
        <response name="success" type="request-redirect" value="EditFrSlipItems">
            <redirect-parameter name="slipId"/>
        </response>
        <response name="error" type="view" value="EditFrSlip"/>
    </request-map>
    <request-map uri="updateFrSlip">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateFrSlip"/>
        <response name="success" type="view" value="EditFrSlip"/>
        <response name="error" type="view" value="EditFrSlip"/>
    </request-map>
    <request-map uri="EditFrSlipItems">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="EditFrSlipItems"/>
    </request-map>
    <request-map uri="createFrSlipItem">
        <security https="true" auth="true"/>
        <event type="service" invoke="createFrSlipItem"/>
        <response name="success" type="view" value="EditFrSlipItems"/>
        <response name="error" type="view" value="EditFrSlipItems"/>
    </request-map>
    <request-map uri="updateFrSlipItem">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateFrSlipItem"/>
        <response name="success" type="view" value="EditFrSlipItems"/>
        <response name="error" type="view" value="EditFrSlipItems"/>
    </request-map>
    <request-map uri="deleteFrSlipItem">
        <security https="true" auth="true"/>
        <event type="service" invoke="deleteFrSlipItem"/>
        <response name="success" type="view" value="EditFrSlipItems"/>
        <response name="error" type="view" value="EditFrSlipItems"/>
    </request-map>
    <request-map uri="ViewFrSlip">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="ViewFrSlip"/>
    </request-map>
    <request-map uri="requestFrSlip">
        <security https="true" auth="true"/>
        <event type="service" invoke="requestFrSlip"/>
        <response name="success" type="view" value="ViewFrSlip"/>
        <response name="error" type="view" value="ViewFrSlip"/>
    </request-map>

    <!-- ================ 결재 ================ -->
    <request-map uri="FindFrApproval">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrApproval"/>
    </request-map>
    <request-map uri="approveFrSlip">
        <security https="true" auth="true"/>
        <event type="service" invoke="approveFrSlip"/>
        <response name="success" type="view" value="ViewFrSlip"/>
        <response name="error" type="view" value="ViewFrSlip"/>
    </request-map>
    <request-map uri="rejectFrSlip">
        <security https="true" auth="true"/>
        <event type="service" invoke="rejectFrSlip"/>
        <response name="success" type="view" value="ViewFrSlip"/>
        <response name="error" type="view" value="ViewFrSlip"/>
    </request-map>

    <!-- ================ 결산 마감 ================ -->
    <request-map uri="FindFrClosePeriod">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrClosePeriod"/>
    </request-map>
    <request-map uri="closeFrPeriod">
        <security https="true" auth="true"/>
        <event type="service" invoke="closeFrPeriod"/>
        <response name="success" type="view" value="FindFrClosePeriod"/>
        <response name="error" type="view" value="FindFrClosePeriod"/>
    </request-map>
    <request-map uri="reopenFrPeriod">
        <security https="true" auth="true"/>
        <event type="service" invoke="reopenFrPeriod"/>
        <response name="success" type="view" value="FindFrClosePeriod"/>
        <response name="error" type="view" value="FindFrClosePeriod"/>
    </request-map>

    <!-- ================ 세금계산서 ================ -->
    <request-map uri="FindFrTaxInvoice">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrTaxInvoice"/>
    </request-map>
    <request-map uri="EditFrTaxInvoice">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="EditFrTaxInvoice"/>
    </request-map>
    <request-map uri="createFrTaxInvoice">
        <security https="true" auth="true"/>
        <event type="service" invoke="createFrTaxInvoice"/>
        <response name="success" type="request-redirect" value="ViewFrTaxInvoice">
            <redirect-parameter name="taxInvoiceId"/>
        </response>
        <response name="error" type="view" value="EditFrTaxInvoice"/>
    </request-map>
    <request-map uri="ViewFrTaxInvoice">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="ViewFrTaxInvoice"/>
    </request-map>
    <request-map uri="cancelFrTaxInvoice">
        <security https="true" auth="true"/>
        <event type="service" invoke="cancelFrTaxInvoice"/>
        <response name="success" type="view" value="ViewFrTaxInvoice"/>
        <response name="error" type="view" value="ViewFrTaxInvoice"/>
    </request-map>

    <!-- ================ 거래처 지급조건 ================ -->
    <request-map uri="FindFrVendorPayTerm">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrVendorPayTerm"/>
    </request-map>
    <request-map uri="EditFrVendorPayTerm">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="EditFrVendorPayTerm"/>
    </request-map>
    <request-map uri="createFrVendorPayTerm">
        <security https="true" auth="true"/>
        <event type="service" invoke="createFrVendorPayTerm"/>
        <response name="success" type="view" value="FindFrVendorPayTerm"/>
        <response name="error" type="view" value="EditFrVendorPayTerm"/>
    </request-map>
    <request-map uri="updateFrVendorPayTerm">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateFrVendorPayTerm"/>
        <response name="success" type="view" value="FindFrVendorPayTerm"/>
        <response name="error" type="view" value="EditFrVendorPayTerm"/>
    </request-map>
    <request-map uri="deleteFrVendorPayTerm">
        <security https="true" auth="true"/>
        <event type="service" invoke="deleteFrVendorPayTerm"/>
        <response name="success" type="view" value="FindFrVendorPayTerm"/>
        <response name="error" type="view" value="FindFrVendorPayTerm"/>
    </request-map>

    <!-- ================ 지급계획 ================ -->
    <request-map uri="FindFrPaymentPlan">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrPaymentPlan"/>
    </request-map>
    <request-map uri="completeFrPaymentPlan">
        <security https="true" auth="true"/>
        <event type="service" invoke="completeFrPaymentPlan"/>
        <response name="success" type="view" value="FindFrPaymentPlan"/>
        <response name="error" type="view" value="FindFrPaymentPlan"/>
    </request-map>

    <!-- 2019.01.21 정해인 지급예정표 -->
    <request-map uri="FrPaymentSchedule">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FrPaymentSchedule"/>
    </request-map>

    <!-- 20201222 홍성민 기존 로직 백업 -->
    <request-map uri="FrPaymentScheduleNew">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FrPaymentSchedule"/>
    </request-map>
    <!-- 2019.01.28 정해인 지급예정표 엑셀(CSV) 다운로드 -->
    <request-map uri="FrPaymentSchedule.csv">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FrPaymentScheduleCsv"/>
    </request-map>

    <!-- ================ 법인카드 (2021.02 핀링크 송태호) ================ -->
    <request-map uri="FindFrCardTx">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrCardTx"/>
    </request-map>
    <request-map uri="FrCardTxUpload">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FrCardTxUpload"/>
    </request-map>
    <request-map uri="uploadFrCardTxFile">
        <security https="true" auth="true"/>
        <event type="service" invoke="uploadFrCardTxFile"/>
        <response name="success" type="view" value="FrCardTxUpload"/>
        <response name="error" type="view" value="FrCardTxUpload"/>
    </request-map>
    <request-map uri="checkFrCardTxRestrict">
        <security https="true" auth="true"/>
        <event type="service" invoke="checkFrCardTxRestrict"/>
        <response name="success" type="view" value="FindFrCardTx"/>
        <response name="error" type="view" value="FindFrCardTx"/>
    </request-map>
    <request-map uri="FindFrCardMaster">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindFrCardMaster"/>
    </request-map>
    <request-map uri="createFrCardMaster">
        <security https="true" auth="true"/>
        <event type="service" invoke="createFrCardMaster"/>
        <response name="success" type="view" value="FindFrCardMaster"/>
        <response name="error" type="view" value="FindFrCardMaster"/>
    </request-map>
    <request-map uri="updateFrCardMaster">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateFrCardMaster"/>
        <response name="success" type="view" value="FindFrCardMaster"/>
        <response name="error" type="view" value="FindFrCardMaster"/>
    </request-map>

    <!-- ================ Lookup ================ -->
    <request-map uri="LookupGlAccount">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="LookupGlAccount"/>
    </request-map>

    <!-- View Mappings -->
    <view-map name="main" type="screen" page="component://fracct/widget/CommonScreens.xml#Main"/>

    <view-map name="FindFrSlip" type="screen" page="component://fracct/widget/FrSlipScreens.xml#FindFrSlip"/>
    <view-map name="EditFrSlip" type="screen" page="component://fracct/widget/FrSlipScreens.xml#EditFrSlip"/>
    <view-map name="EditFrSlipItems" type="screen" page="component://fracct/widget/FrSlipScreens.xml#EditFrSlipItems"/>
    <view-map name="ViewFrSlip" type="screen" page="component://fracct/widget/FrSlipScreens.xml#ViewFrSlip"/>
    <view-map name="FindFrApproval" type="screen" page="component://fracct/widget/FrSlipScreens.xml#FindFrApproval"/>
    <view-map name="FrSlipUpload" type="screen" page="component://fracct/widget/FrSlipScreens.xml#FrSlipUpload"/>

    <view-map name="FindFrClosePeriod" type="screen" page="component://fracct/widget/FrPeriodScreens.xml#FindFrClosePeriod"/>

    <view-map name="FindFrTaxInvoice" type="screen" page="component://fracct/widget/FrTaxInvoiceScreens.xml#FindFrTaxInvoice"/>
    <view-map name="EditFrTaxInvoice" type="screen" page="component://fracct/widget/FrTaxInvoiceScreens.xml#EditFrTaxInvoice"/>
    <view-map name="ViewFrTaxInvoice" type="screen" page="component://fracct/widget/FrTaxInvoiceScreens.xml#ViewFrTaxInvoice"/>

    <view-map name="FindFrVendorPayTerm" type="screen" page="component://fracct/widget/FrPaymentScreens.xml#FindFrVendorPayTerm"/>
    <view-map name="EditFrVendorPayTerm" type="screen" page="component://fracct/widget/FrPaymentScreens.xml#EditFrVendorPayTerm"/>
    <view-map name="FindFrPaymentPlan" type="screen" page="component://fracct/widget/FrPaymentScreens.xml#FindFrPaymentPlan"/>
    <view-map name="FrPaymentSchedule" type="screen" page="component://fracct/widget/FrPaymentScreens.xml#FrPaymentSchedule"/>
    <view-map name="FrPaymentScheduleCsv" type="screencsv" page="component://fracct/widget/FrPaymentScreens.xml#FrPaymentScheduleCsv" content-type="text/csv" encoding="none"/>

    <view-map name="FindFrCardTx" type="screen" page="component://fracct/widget/FrCardScreens.xml#FindFrCardTx"/>
    <view-map name="FrCardTxUpload" type="screen" page="component://fracct/widget/FrCardScreens.xml#FrCardTxUpload"/>
    <view-map name="FindFrCardMaster" type="screen" page="component://fracct/widget/FrCardScreens.xml#FindFrCardMaster"/>

    <view-map name="LookupGlAccount" type="screen" page="component://fracct/widget/LookupScreens.xml#LookupGlAccount"/>
</site-conf>
