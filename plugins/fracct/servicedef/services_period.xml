<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">
    <description>FutureRetail Accounting - Monthly Closing Services</description>
    <vendor>OpenBridge Systems</vendor>
    <version>1.0</version>

    <service name="checkFrClosePeriod" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="checkFrClosePeriod" auth="true">
        <description>
            전표일자의 년월이 마감(FrClosePeriod.isClosed=Y)되었으면 오류.
            secas.xml 에서 전표 생성/수정 서비스 invoke 시점에 호출된다.
            slipDate 가 없으면 slipId 로 저장된 전표일자를 조회하여 체크한다.
        </description>
        <attribute name="slipId" type="String" mode="IN" optional="true"/>
        <attribute name="slipDate" type="java.sql.Date" mode="IN" optional="true"/>
    </service>

    <!-- 20210127 송태호 기존 로직 백업 -->
    <service name="checkFrClosePeriodOld" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="checkFrClosePeriod" auth="true">
        <description>
            전표일자의 년월이 마감(FrClosePeriod.isClosed=Y)되었으면 오류.
            secas.xml 에서 전표 생성/수정 서비스 invoke 시점에 호출된다.
            slipDate 가 없으면 slipId 로 저장된 전표일자를 조회하여 체크한다.
        </description>
        <attribute name="slipId" type="String" mode="IN" optional="true"/>
        <attribute name="slipDate" type="java.sql.Date" mode="IN" optional="true"/>
    </service>

    <!-- 20201106 홍성민 오타수정용 신규 -->
    <service name="checkFrClosePeroid" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="checkFrClosePeriod" auth="true">
        <description>
            전표일자의 년월이 마감(FrClosePeriod.isClosed=Y)되었으면 오류.
            secas.xml 에서 전표 생성/수정 서비스 invoke 시점에 호출된다.
            slipDate 가 없으면 slipId 로 저장된 전표일자를 조회하여 체크한다.
        </description>
        <attribute name="slipId" type="String" mode="IN" optional="true"/>
        <attribute name="slipDate" type="java.sql.Date" mode="IN" optional="true"/>
    </service>

    <service name="closeFrPeriod" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="closeFrPeriod" auth="true">
        <description>월 마감 (isClosed=Y)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <!-- 20201208 홍성민 오타수정용 신규 -->
    <service name="closeFrPeroid" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="closeFrPeriod" auth="true">
        <description>월 마감 (isClosed=Y)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <service name="reopenFrPeriod" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="reopenFrPeriod" auth="true">
        <description>월 마감 해제 (isClosed=N)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <!-- 2024.05.27 한예린 오타수정용 신규 -->
    <service name="reopenFrPeroid" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="reopenFrPeriod" auth="true">
        <description>월 마감 해제 (isClosed=N)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <!-- 2021.09.27 정해인 마감 해제 권한 -->
    <service name="releaseFrClosePeriod" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="releaseFrClosePeriod" auth="true">
        <description>월 마감 해제 (isClosed=N) - 마감 해제 권한자(FRACCT_CLOSE_ADMIN), 해제 사유 필수</description>
        <permission-service service-name="fracctCloseAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <!-- 20221114 임재훈 백업 -->
    <service name="releaseFrClosePeriod2" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="releaseFrClosePeriod" auth="true">
        <description>월 마감 해제 (isClosed=N) - 마감 해제 권한자(FRACCT_CLOSE_ADMIN), 해제 사유 필수</description>
        <permission-service service-name="fracctCloseAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <!-- 2023.08.28 한예린 오타수정용 신규 -->
    <service name="releaseFrClosePeroid2" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="releaseFrClosePeriod" auth="true">
        <description>월 마감 해제 (isClosed=N) - 마감 해제 권한자(FRACCT_CLOSE_ADMIN), 해제 사유 필수</description>
        <permission-service service-name="fracctCloseAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="closeYearMonth" type="String" mode="IN" optional="false"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <service name="isFrCloseCheckTarget" engine="simple"
            location="component://fracct/minilang/FrClosePeriodServices.xml" invoke="isFrCloseCheckTarget" auth="false">
        <description>
            secas.xml 마감 체크(checkFrClosePeriod) ECA 조건 서비스.
            로그인 사용자가 FRACCT_CLOSE_ADMIN 이면 conditionReply=false (마감 체크 생략)
        </description>
        <attribute name="serviceContext" type="Map" mode="IN" optional="true"/>
        <attribute name="serviceName" type="String" mode="IN" optional="true"/>
        <attribute name="conditionReply" type="Boolean" mode="OUT" optional="false"/>
    </service>
</services>
