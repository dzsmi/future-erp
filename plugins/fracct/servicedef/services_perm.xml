<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">
    <description>FutureRetail Accounting Permission Services</description>
    <vendor>OpenBridge Systems</vendor>
    <version>1.0</version>

    <service name="fracctUserPermissionCheck" engine="simple"
            location="component://fracct/minilang/permission/FrAcctPermissionServices.xml" invoke="fracctUserPermissionCheck">
        <description>재경 현업 사용자 권한 체크 (FRACCT_VIEW / FRACCT_ADMIN)</description>
        <implements service="permissionInterface"/>
    </service>

    <service name="fracctAdminPermissionCheck" engine="simple"
            location="component://fracct/minilang/permission/FrAcctPermissionServices.xml" invoke="fracctAdminPermissionCheck">
        <description>재경팀 권한 체크 (FRACCT_ADMIN)</description>
        <implements service="permissionInterface"/>
    </service>
</services>
