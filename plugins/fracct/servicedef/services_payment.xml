<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 김현석 / 2018.04.30 -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">
    <description>FutureRetail Accounting - Vendor Payment Services</description>
    <vendor>OpenBridge Systems</vendor>
    <version>1.0</version>

    <!-- ================= 거래처 지급조건 ================= -->
    <service name="createFrVendorPayTerm" default-entity-name="FrVendorPayTerm" engine="entity-auto" invoke="create" auth="true">
        <description>거래처 지급조건 등록</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="CREATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>
    <service name="updateFrVendorPayTerm" default-entity-name="FrVendorPayTerm" engine="entity-auto" invoke="update" auth="true">
        <description>거래처 지급조건 수정</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="UPDATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>
    <service name="deleteFrVendorPayTerm" default-entity-name="FrVendorPayTerm" engine="entity-auto" invoke="delete" auth="true">
        <description>거래처 지급조건 삭제</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="DELETE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>

    <!-- ================= 지급계획 ================= -->
    <service name="createFrPaymentPlanFromTaxInvoice" engine="simple"
            location="component://fracct/minilang/FrPaymentServices.xml" invoke="createFrPaymentPlanFromTaxInvoice" auth="true">
        <description>매입 세금계산서로 지급계획 생성 (지급기일 = 발행일이 속한 달의 다음 달 말일)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="CREATE"/>
        <attribute name="taxInvoiceId" type="String" mode="IN" optional="false"/>
        <attribute name="paymentPlanId" type="String" mode="OUT" optional="false"/>
        <attribute name="dueDate" type="java.sql.Date" mode="OUT" optional="false"/>
    </service>

    <service name="completeFrPaymentPlan" engine="simple"
            location="component://fracct/minilang/FrPaymentServices.xml" invoke="completeFrPaymentPlan" auth="true">
        <description>지급완료 처리 (FRPP_PLANNED → FRPP_PAID)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="UPDATE"/>
        <attribute name="paymentPlanId" type="String" mode="IN" optional="false"/>
        <attribute name="paidDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <!-- 2019.01.21 정해인 : 거래처 지급예정표 (지급기일 = 발행일 + 60일, 재무팀 요청) -->
    <service name="getFrPaymentSchedule" engine="groovy"
            location="component://fracct/groovyScripts/payment/FrPaymentScheduleServices.groovy" invoke="getFrPaymentSchedule" auth="true">
        <description>거래처 지급예정표 조회 (매입 세금계산서 발행일 + 60일 기준)</description>
        <permission-service service-name="fracctAdminPermissionCheck" main-action="VIEW"/>
        <attribute name="fromDueDate" type="java.sql.Date" mode="IN" optional="true"/>
        <attribute name="thruDueDate" type="java.sql.Date" mode="IN" optional="true"/>
        <attribute name="partyId" type="String" mode="IN" optional="true"/>
        <attribute name="includePaid" type="String" mode="IN" optional="true"/>
        <attribute name="scheduleList" type="List" mode="OUT" optional="true"/>
        <attribute name="totalAmount" type="BigDecimal" mode="OUT" optional="true"/>
    </service>
</services>
