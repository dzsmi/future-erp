<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: (주)핀링크 송태호 / 2021.06.21 -->
<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <form name="EditFrETaxInvoice" type="single" target="createFrETaxInvoice"
        header-row-style="header-row" default-table-style="basic-table">
        <field name="partyId" title="${uiLabelMap.FrAcctETaxBuyer}" required-field="true"><lookup target-form-name="LookupPartyName"/></field>
        <field name="issueDate" title="${uiLabelMap.FrAcctIssueDate}" required-field="true"><date-time type="date"/></field>
        <field name="buyerEmail" title="${uiLabelMap.FrAcctETaxBuyerEmail}"><text size="40" maxlength="255"/></field>
        <field name="description" title="${uiLabelMap.CommonDescription}"><text size="60" maxlength="255"/></field>
        <field name="submitButton" title="${uiLabelMap.CommonCreate}"><submit button-type="button"/></field>
    </form>

    <form name="FrETaxInvoiceHeader" type="single" default-map-name="taxInvoice"
        header-row-style="header-row" default-table-style="basic-table">
        <field name="taxInvoiceId" title="${uiLabelMap.FrAcctTaxInvoiceId}" position="1"><display/></field>
        <field name="statusId" title="${uiLabelMap.CommonStatus}" position="2"><display-entity entity-name="StatusItem"/></field>
        <field name="partyId" title="${uiLabelMap.FrAcctETaxBuyer}" position="1">
            <display-entity entity-name="PartyNameView" key-field-name="partyId" description="${groupName}${lastName}${firstName} [${partyId}]"/>
        </field>
        <field name="issueDate" title="${uiLabelMap.FrAcctIssueDate}" position="2"><display type="date"/></field>
        <field name="supplyAmount" title="${uiLabelMap.FrAcctSupplyAmount}" position="1"><display type="currency" currency="KRW"/></field>
        <field name="vatAmount" title="${uiLabelMap.FrAcctVatAmount}" position="2"><display type="currency" currency="KRW"/></field>
        <field name="totalAmount" title="${uiLabelMap.FrAcctTotalAmount}" position="1"><display type="currency" currency="KRW"/></field>
        <field name="taxInvoiceNo" title="${uiLabelMap.FrAcctETaxNtsNo}" position="2"><display/></field>
        <field name="buyerEmail" title="${uiLabelMap.FrAcctETaxBuyerEmail}" position="1"><display/></field>
        <field name="etaxSendStatus" title="${uiLabelMap.FrAcctETaxSendStatus}" position="2"><display/></field>
        <field name="etaxResultMsg" title="${uiLabelMap.CommonMessage}"><display/></field>
    </form>

    <form name="ListFrETaxInvoiceItem" type="list" list-name="etaxItems"
        odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table">
        <field name="itemSeqId" title="${uiLabelMap.CommonSequenceNum}"><display/></field>
        <field name="supplyDate" title="${uiLabelMap.FrAcctETaxSupplyDate}"><display type="date"/></field>
        <field name="itemName" title="${uiLabelMap.FrAcctETaxItemName}"><display/></field>
        <field name="itemSpec" title="${uiLabelMap.FrAcctETaxItemSpec}"><display/></field>
        <field name="quantity" title="${uiLabelMap.CommonQuantity}"><display/></field>
        <field name="unitPrice" title="${uiLabelMap.FrAcctETaxUnitPrice}"><display/></field>
        <field name="supplyAmount" title="${uiLabelMap.FrAcctSupplyAmount}"><display type="currency" currency="KRW"/></field>
        <field name="vatAmount" title="${uiLabelMap.FrAcctVatAmount}"><display type="currency" currency="KRW"/></field>
        <field name="remark" title="${uiLabelMap.CommonComments}"><display/></field>
        <field name="removeLink" title=" " widget-style="buttontext" use-when="&quot;FRTI_DRAFT&quot;.equals(taxInvoice.get(&quot;statusId&quot;))">
            <hyperlink description="${uiLabelMap.CommonRemove}" target="removeFrETaxInvoiceItem" link-type="hidden-form" also-hidden="false">
                <parameter param-name="taxInvoiceId"/>
                <parameter param-name="itemSeqId"/>
            </hyperlink>
        </field>
    </form>

    <form name="AddFrETaxInvoiceItem" type="single" target="addFrETaxInvoiceItem"
        header-row-style="header-row" default-table-style="basic-table">
        <field name="taxInvoiceId"><hidden value="${taxInvoice.taxInvoiceId}"/></field>
        <field name="supplyDate" title="${uiLabelMap.FrAcctETaxSupplyDate}"><date-time type="date" default-value="${taxInvoice.issueDate}"/></field>
        <field name="itemName" title="${uiLabelMap.FrAcctETaxItemName}" required-field="true"><text size="40" maxlength="100"/></field>
        <field name="itemSpec" title="${uiLabelMap.FrAcctETaxItemSpec}"><text size="20" maxlength="60"/></field>
        <field name="quantity" title="${uiLabelMap.CommonQuantity}"><text size="8" default-value="1"/></field>
        <field name="unitPrice" title="${uiLabelMap.FrAcctETaxUnitPrice}" required-field="true"><text size="15"/></field>
        <field name="remark" title="${uiLabelMap.CommonComments}"><text size="40" maxlength="255"/></field>
        <field name="submitButton" title="${uiLabelMap.CommonAdd}" widget-style="smallSubmit"><submit button-type="button"/></field>
    </form>
</forms>
