<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 이소라 / 2018.06.11 -->
<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <form name="FindFrClosePeriodOptions" type="single" target="FindFrClosePeriod"
        header-row-style="header-row" default-table-style="basic-table">
        <field name="closeYear" title="${uiLabelMap.FrAcctCloseYear}"><text size="4" maxlength="4" default-value="${closeYear}"/></field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}" widget-style="smallSubmit"><submit button-type="button"/></field>
    </form>

    <form name="ListFrClosePeriod" type="list" list-name="closePeriodList"
        odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="closeYearMonth" title="${uiLabelMap.FrAcctCloseYearMonth}"><display/></field>
        <field name="isClosed" title="${uiLabelMap.FrAcctIsClosed}">
            <display description="${groovy: isClosed == 'Y' ? uiLabelMap.FrAcctClosed : uiLabelMap.FrAcctOpen}"/>
        </field>
        <field name="closedByUserLogin" title="${uiLabelMap.FrAcctClosedBy}"><display/></field>
        <field name="closedDate" title="${uiLabelMap.FrAcctClosedDate}"><display type="date-time"/></field>
        <field name="comments" title="${uiLabelMap.CommonComments}"><display/></field>
        <field name="closeLink" title=" " widget-style="buttontext" use-when="isClosed!=&quot;Y&quot;">
            <hyperlink description="${uiLabelMap.FrAcctDoClose}" target="closeFrPeriod" link-type="hidden-form" also-hidden="false">
                <parameter param-name="closeYearMonth"/>
                <parameter param-name="closeYear" from-field="closeYear"/>
            </hyperlink>
        </field>
        <field name="closeLink" title=" " widget-style="buttontext" use-when="isClosed==&quot;Y&quot;">
            <hyperlink description="${uiLabelMap.FrAcctDoReopen}" target="reopenFrPeriod" link-type="hidden-form" also-hidden="false"
                request-confirmation="true" confirmation-message="${uiLabelMap.FrAcctReopenConfirm}">
                <parameter param-name="closeYearMonth"/>
                <parameter param-name="closeYear" from-field="closeYear"/>
            </hyperlink>
        </field>
    </form>

    <form name="CloseFrPeriod" type="single" target="closeFrPeriod"
        header-row-style="header-row" default-table-style="basic-table">
        <field name="closeYearMonth" title="${uiLabelMap.FrAcctCloseYearMonth}" tooltip="yyyyMM" required-field="true"><text size="6" maxlength="6"/></field>
        <field name="comments" title="${uiLabelMap.CommonComments}"><text size="60" maxlength="255"/></field>
        <field name="submitButton" title="${uiLabelMap.FrAcctDoClose}"><submit button-type="button"/></field>
    </form>
</forms>
