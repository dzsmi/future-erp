<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 김현석 / 2018.03.12 -->
<simple-methods xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Simple-Method" xsi:schemaLocation="http://ofbiz.apache.org/Simple-Method http://ofbiz.apache.org/dtds/simple-methods.xsd">

    <!-- ================================================================== -->
    <!-- 전표 헤더                                                           -->
    <!-- ================================================================== -->

    <simple-method method-name="createFrSlip" short-description="전표 작성">
        <make-value entity-name="FrSlip" value-field="newEntity"/>
        <set-nonpk-fields map="parameters" value-field="newEntity"/>

        <sequenced-id sequence-name="FrSlip" field="slipSeqId"/>
        <set field="newEntity.slipId" value="FS${slipSeqId}"/>

        <set field="newEntity.statusId" value="FRSLIP_DRAFT"/>
        <set field="newEntity.amount" value="0" type="BigDecimal"/>
        <set field="newEntity.createdByUserLogin" from-field="userLogin.userLoginId"/>
        <set field="newEntity.lastModifiedByUserLogin" from-field="userLogin.userLoginId"/>
        <create-value value-field="newEntity"/>

        <field-to-result field="newEntity.slipId" result-name="slipId"/>
    </simple-method>

    <!-- 법개정 시 같이 수정 필요!! -->
    <simple-method method-name="updateFrSlip" short-description="전표 헤더 수정">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <call-simple-method method-name="checkFrSlipEditable"/>

        <set-nonpk-fields map="parameters" value-field="slip"/>
        <set field="slip.lastModifiedByUserLogin" from-field="userLogin.userLoginId"/>
        <store-value value-field="slip"/>
    </simple-method>

    <!-- 작성중(DRAFT) 또는 반려(REJECTED) 전표만 수정 가능. slip 필드가 로드되어 있어야 함 -->
    <simple-method method-name="checkFrSlipEditable" short-description="전표 수정 가능 여부 체크">
        <if-empty field="slip">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotFound"/></add-error>
            <check-errors/>
        </if-empty>
        <if>
            <condition>
                <and>
                    <if-compare field="slip.statusId" operator="not-equals" value="FRSLIP_DRAFT"/>
                    <if-compare field="slip.statusId" operator="not-equals" value="FRSLIP_REJECTED"/>
                </and>
            </condition>
            <then>
                <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotEditable"/></add-error>
            </then>
        </if>
        <check-errors/>
    </simple-method>

    <!-- ================================================================== -->
    <!-- 전표 항목                                                           -->
    <!-- ================================================================== -->

    <simple-method method-name="createFrSlipItem" short-description="전표 항목 추가">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <call-simple-method method-name="checkFrSlipEditable"/>

        <make-value entity-name="FrSlipItem" value-field="newEntity"/>
        <set field="newEntity.slipId" from-field="slip.slipId"/>
        <set-nonpk-fields map="parameters" value-field="newEntity"/>
        <set field="checkItem" from-field="newEntity"/>
        <call-simple-method method-name="validateFrSlipItemInline"/>
        <make-next-seq-id value-field="newEntity" seq-field-name="slipItemSeqId" numeric-padding="3"/>
        <create-value value-field="newEntity"/>

        <call-simple-method method-name="recalcFrSlipAmount"/>
        <field-to-result field="newEntity.slipItemSeqId" result-name="slipItemSeqId"/>
    </simple-method>

    <simple-method method-name="updateFrSlipItem" short-description="전표 항목 수정">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <call-simple-method method-name="checkFrSlipEditable"/>

        <entity-one entity-name="FrSlipItem" value-field="slipItem"/>
        <if-empty field="slipItem">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipItemNotFound"/></add-error>
            <check-errors/>
        </if-empty>
        <set-nonpk-fields map="parameters" value-field="slipItem"/>
        <set field="checkItem" from-field="slipItem"/>
        <call-simple-method method-name="validateFrSlipItemInline"/>
        <store-value value-field="slipItem"/>

        <call-simple-method method-name="recalcFrSlipAmount"/>
    </simple-method>

    <simple-method method-name="deleteFrSlipItem" short-description="전표 항목 삭제">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <call-simple-method method-name="checkFrSlipEditable"/>

        <entity-one entity-name="FrSlipItem" value-field="slipItem"/>
        <if-not-empty field="slipItem">
            <remove-value value-field="slipItem"/>
        </if-not-empty>

        <call-simple-method method-name="recalcFrSlipAmount"/>
    </simple-method>

    <!-- 2019.09.16 정해인 백업 -->
    <simple-method method-name="deleteFrSlipItemBak" short-description="전표 항목 삭제">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <call-simple-method method-name="checkFrSlipEditable"/>

        <entity-one entity-name="FrSlipItem" value-field="slipItem"/>
        <if-not-empty field="slipItem">
            <remove-value value-field="slipItem"/>
        </if-not-empty>

        <call-simple-method method-name="recalcFrSlipAmount"/>
    </simple-method>

    <!-- 차대구분(D/C)·금액(양수) 검증. checkItem 필드 필요 -->
    <simple-method method-name="validateFrSlipItemInline" short-description="차대구분/금액 검증">
        <if>
            <condition>
                <and>
                    <if-compare field="checkItem.debitCreditFlag" operator="not-equals" value="D"/>
                    <if-compare field="checkItem.debitCreditFlag" operator="not-equals" value="C"/>
                </and>
            </condition>
            <then>
                <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipItemBadDebitCreditFlag"/></add-error>
            </then>
        </if>
        <if-compare field="checkItem.amount" operator="less-equals" value="0" type="BigDecimal">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipItemAmountMustBePositive"/></add-error>
        </if-compare>
        <check-errors/>
    </simple-method>

    <!-- slipId 기준 차변/대변 합계 → debitTotal, creditTotal -->
    <!-- 2024 전환 예정 -->
    <simple-method method-name="sumFrSlipItems" short-description="전표 차대 합계">
        <entity-and entity-name="FrSlipItem" list="slipItems">
            <field-map field-name="slipId" from-field="slipId"/>
        </entity-and>
        <calculate field="debitTotal" type="BigDecimal"><number value="0"/></calculate>
        <calculate field="creditTotal" type="BigDecimal"><number value="0"/></calculate>
        <iterate list="slipItems" entry="slipItem">
            <if-compare field="slipItem.debitCreditFlag" operator="equals" value="D">
                <calculate field="debitTotal" type="BigDecimal">
                    <calcop operator="add">
                        <calcop operator="get" field="debitTotal"/>
                        <calcop operator="get" field="slipItem.amount"/>
                    </calcop>
                </calculate>
                <else>
                    <calculate field="creditTotal" type="BigDecimal">
                        <calcop operator="add">
                            <calcop operator="get" field="creditTotal"/>
                            <calcop operator="get" field="slipItem.amount"/>
                        </calcop>
                    </calculate>
                </else>
            </if-compare>
        </iterate>
    </simple-method>

    <!-- 항목 변경 후 전표금액(차변 합계) 갱신. slip 필드가 로드되어 있어야 함 -->
    <simple-method method-name="recalcFrSlipAmount" short-description="전표금액 재계산">
        <set field="slipId" from-field="slip.slipId"/>
        <call-simple-method method-name="sumFrSlipItems"/>
        <set field="slip.amount" from-field="debitTotal"/>
        <set field="slip.lastModifiedByUserLogin" from-field="userLogin.userLoginId"/>
        <store-value value-field="slip"/>
    </simple-method>

    <simple-method method-name="checkFrSlipBalance" short-description="전표 차대 합계 일치 검사">
        <set field="slipId" from-field="parameters.slipId"/>
        <call-simple-method method-name="sumFrSlipItems"/>
        <set field="isBalanced" value="N"/>
        <if>
            <condition>
                <and>
                    <if-compare-field field="debitTotal" to-field="creditTotal" operator="equals" type="BigDecimal"/>
                    <if-compare field="debitTotal" operator="greater" value="0" type="BigDecimal"/>
                </and>
            </condition>
            <then>
                <set field="isBalanced" value="Y"/>
            </then>
        </if>
        <field-to-result field="debitTotal"/>
        <field-to-result field="creditTotal"/>
        <field-to-result field="isBalanced"/>
    </simple-method>

    <!-- ================================================================== -->
    <!-- 결재                                                               -->
    <!-- ================================================================== -->

    <!-- A1 결재선 (2018.03 재경팀 협의 기준)
         전표금액 <= 1,000,000        : FRAPPR_TEAM (팀장 전결)
         전표금액 <= 10,000,000       : FRAPPR_DIV  (본부장)
         전표금액 >  10,000,000       : FRAPPR_CEO  (대표이사)
         입력: apprAmount / 출력: apprLevelEnumId
         ※ 기준 변경 시 data/FrAcctTypeData.xml 결재레벨 description 도 같이 수정 -->
    <simple-method method-name="determineApprLevel" short-description="전표금액으로 결재레벨 결정">
        <if-empty field="apprAmount">
            <set field="apprAmount" value="0" type="BigDecimal"/>
        </if-empty>
        <if>
            <condition>
                <!-- 2018.11 재무팀 요청 팀장 전결 100만 -> 300만 (정해인) -->
                <if-compare field="apprAmount" operator="less-equals" value="3000000" type="BigDecimal"/>
            </condition>
            <then>
                <set field="apprLevelEnumId" value="FRAPPR_TEAM"/>
            </then>
            <else-if>
                <condition>
                    <if-compare field="apprAmount" operator="less-equals" value="10000000" type="BigDecimal"/>
                </condition>
                <then>
                    <set field="apprLevelEnumId" value="FRAPPR_DIV"/>
                </then>
            </else-if>
            <else>
                <set field="apprLevelEnumId" value="FRAPPR_CEO"/>
            </else>
        </if>
    </simple-method>

    <simple-method method-name="getFrApprLevel" short-description="결재레벨 조회">
        <set field="apprAmount" from-field="parameters.amount"/>
        <call-simple-method method-name="determineApprLevel"/>
        <field-to-result field="apprLevelEnumId"/>
    </simple-method>

    <!-- 다음 결재 단계: (없음) → TEAM → DIV → CEO. slip 필드 필요, 결과 nextStepEnumId -->
    <simple-method method-name="getNextApprStepInline" short-description="다음 결재 단계">
        <clear-field field="nextStepEnumId"/>
        <if>
            <condition>
                <if-empty field="slip.apprStepEnumId"/>
            </condition>
            <then>
                <set field="nextStepEnumId" value="FRAPPR_TEAM"/>
            </then>
            <else-if>
                <condition>
                    <if-compare field="slip.apprStepEnumId" operator="equals" value="FRAPPR_TEAM"/>
                </condition>
                <then>
                    <set field="nextStepEnumId" value="FRAPPR_DIV"/>
                </then>
            </else-if>
            <else-if>
                <condition>
                    <if-compare field="slip.apprStepEnumId" operator="equals" value="FRAPPR_DIV"/>
                </condition>
                <then>
                    <set field="nextStepEnumId" value="FRAPPR_CEO"/>
                </then>
            </else-if>
            <else>
                <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipApprAlreadyFinished"/></add-error>
            </else>
        </if>
        <check-errors/>
    </simple-method>

    <!-- 결재이력 기록. slip, apprActionId, histLevelEnumId, nowTimestamp 필요 -->
    <simple-method method-name="createFrApprHistInline" short-description="결재이력 기록">
        <make-value entity-name="FrApprHist" value-field="apprHist"/>
        <set field="apprHist.slipId" from-field="slip.slipId"/>
        <make-next-seq-id value-field="apprHist" seq-field-name="apprSeqId" numeric-padding="3"/>
        <set field="apprHist.apprActionId" from-field="apprActionId"/>
        <set field="apprHist.apprLevelEnumId" from-field="histLevelEnumId"/>
        <set field="apprHist.apprUserLoginId" from-field="userLogin.userLoginId"/>
        <set field="apprHist.apprDate" from-field="nowTimestamp"/>
        <set field="apprHist.slipAmount" from-field="slip.amount"/>
        <set field="apprHist.comments" from-field="parameters.comments"/>
        <create-value value-field="apprHist"/>
    </simple-method>

    <simple-method method-name="requestFrSlip" short-description="전표 상신">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <call-simple-method method-name="checkFrSlipEditable"/>

        <!-- 차대 합계 일치 검사 -->
        <set field="slipId" from-field="slip.slipId"/>
        <call-simple-method method-name="sumFrSlipItems"/>
        <if-compare field="debitTotal" operator="less-equals" value="0" type="BigDecimal">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNoItems"/></add-error>
            <check-errors/>
        </if-compare>
        <if-compare-field field="debitTotal" to-field="creditTotal" operator="not-equals" type="BigDecimal">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotBalanced"/></add-error>
        </if-compare-field>
        <check-errors/>

        <!-- A1 결재선 결정 -->
        <set field="apprAmount" from-field="debitTotal"/>
        <call-simple-method method-name="determineApprLevel"/>

        <now-timestamp field="nowTimestamp"/>
        <set field="slip.amount" from-field="debitTotal"/>
        <set field="slip.apprLevelEnumId" from-field="apprLevelEnumId"/>
        <clear-field field="slip.apprStepEnumId"/>
        <set field="slip.statusId" value="FRSLIP_REQUESTED"/>
        <set field="slip.requestedDate" from-field="nowTimestamp"/>
        <set field="slip.lastModifiedByUserLogin" from-field="userLogin.userLoginId"/>
        <store-value value-field="slip"/>

        <set field="apprActionId" value="REQUEST"/>
        <set field="histLevelEnumId" from-field="apprLevelEnumId"/>
        <call-simple-method method-name="createFrApprHistInline"/>

        <field-to-result field="apprLevelEnumId"/>
    </simple-method>

    <simple-method method-name="approveFrSlip" short-description="전표 승인">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <if-empty field="slip">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotFound"/></add-error>
            <check-errors/>
        </if-empty>
        <if-compare field="slip.statusId" operator="not-equals" value="FRSLIP_REQUESTED">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotRequested"/></add-error>
            <check-errors/>
        </if-compare>

        <call-simple-method method-name="getNextApprStepInline"/>
        <now-timestamp field="nowTimestamp"/>
        <set field="slip.apprStepEnumId" from-field="nextStepEnumId"/>
        <set field="slip.lastModifiedByUserLogin" from-field="userLogin.userLoginId"/>

        <set field="apprActionId" value="APPROVE"/>
        <set field="histLevelEnumId" from-field="nextStepEnumId"/>

        <if-compare-field field="nextStepEnumId" to-field="slip.apprLevelEnumId" operator="equals">
            <!-- 최종 결재레벨 승인 -->
            <set field="slip.statusId" value="FRSLIP_APPROVED"/>
            <set field="slip.approvedDate" from-field="nowTimestamp"/>
            <store-value value-field="slip"/>
            <call-simple-method method-name="createFrApprHistInline"/>

            <!-- 코어 회계 거래 생성 후 acctgTransId 연결 -->
            <set field="postAcctgMap.slipId" from-field="slip.slipId"/>
            <call-service service-name="postFrSlipAcctgTrans" in-map-name="postAcctgMap">
                <result-to-field result-name="acctgTransId"/>
            </call-service>
            <field-to-result field="acctgTransId"/>
            <else>
                <!-- 중간 결재: 다음 단계 대기 -->
                <store-value value-field="slip"/>
                <call-simple-method method-name="createFrApprHistInline"/>
            </else>
        </if-compare-field>
    </simple-method>

    <simple-method method-name="rejectFrSlip" short-description="전표 반려">
        <entity-one entity-name="FrSlip" value-field="slip"/>
        <if-empty field="slip">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotFound"/></add-error>
            <check-errors/>
        </if-empty>
        <if-compare field="slip.statusId" operator="not-equals" value="FRSLIP_REQUESTED">
            <add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctSlipNotRequested"/></add-error>
            <check-errors/>
        </if-compare>

        <call-simple-method method-name="getNextApprStepInline"/>
        <now-timestamp field="nowTimestamp"/>
        <set field="slip.statusId" value="FRSLIP_REJECTED"/>
        <clear-field field="slip.apprStepEnumId"/>
        <set field="slip.lastModifiedByUserLogin" from-field="userLogin.userLoginId"/>
        <store-value value-field="slip"/>

        <set field="apprActionId" value="REJECT"/>
        <set field="histLevelEnumId" from-field="nextStepEnumId"/>
        <call-simple-method method-name="createFrApprHistInline"/>
    </simple-method>
</simple-methods>
