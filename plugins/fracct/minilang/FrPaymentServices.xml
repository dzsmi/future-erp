<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 김현석 / 2018.04.30 -->
<simple-methods xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns="http://ofbiz.apache.org/Simple-Method" xsi:schemaLocation="http://ofbiz.apache.org/Simple-Method http://ofbiz.apache.org/dtds/simple-methods.xsd">

	<simple-method method-name="createFrPaymentPlanFromTaxInvoice" short-description="매입 세금계산서 지급계획 생성">
		<entity-one entity-name="FrTaxInvoice" value-field="taxInvoice"/>
		<if-empty field="taxInvoice">
			<add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctTaxInvoiceNotFound"/></add-error>
			<check-errors/>
		</if-empty>
		<if-compare field="taxInvoice.taxInvoiceTypeEnumId" operator="not-equals" value="FRTI_PURCHASE">
			<add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctPaymentPlanPurchaseOnly"/></add-error>
			<check-errors/>
		</if-compare>

		<!-- A5 지급기일 = 발행일이 속한 달의 다음 달 말일
			 예) 2018-03-05 발행 → 2018-04-30, 2018-01-31 발행 → 2018-02-28
			 ※ 거래처별 지급일수(FrVendorPayTerm)는 아직 반영하지 않음
			   → 2024.05.20 한예린 [SR-2024-0512] 반영 : 지급조건 등록 거래처는 발행일 + 지급일수 (아래) -->
		<set field="daysLater" value="0" type="Integer"/>
		<set field="monthsLater" value="1" type="Integer"/>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="toTimestamp" ret-field="issueStamp">
			<field field="taxInvoice.issueDate" type="java.util.Date"/>
		</call-class-method>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="getMonthStart" ret-field="nextMonthStart">
			<field field="issueStamp" type="java.sql.Timestamp"/>
			<field field="daysLater" type="int"/>
			<field field="monthsLater" type="int"/>
		</call-class-method>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="getMonthEnd" ret-field="nextMonthEnd">
			<field field="nextMonthStart" type="java.sql.Timestamp"/>
			<field field="timeZone" type="java.util.TimeZone"/>
			<field field="locale" type="java.util.Locale"/>
		</call-class-method>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="toSqlDate" ret-field="dueDate">
			<field field="nextMonthEnd" type="java.util.Date"/>
		</call-class-method>

		<!-- 2024.05.20 한예린 [SR-2024-0512] 거래처별 지급조건(FrVendorPayTerm) 반영 (재무팀 요청)
			 지급조건이 등록되어 있고 지급일수 > 0 이면 지급기일 = 발행일 + 지급일수
			 없으면 기존대로 익월 말일 -->
		<entity-one entity-name="FrVendorPayTerm" value-field="vendorPayTerm" auto-field-map="false">
			<field-map field-name="partyId" from-field="taxInvoice.partyId"/>
		</entity-one>
		<if-not-empty field="vendorPayTerm.payDays">
			<if-compare field="vendorPayTerm.payDays" operator="greater" value="0" type="Long">
				<set field="dueDate" value="${groovy: java.sql.Date.valueOf(taxInvoice.issueDate.toLocalDate().plusDays(vendorPayTerm.payDays as long))}" type="Date"/>
				<log level="info" message="지급계획 거래처 지급조건 적용 partyId=${taxInvoice.partyId} 지급일수=${vendorPayTerm.payDays} 지급기일=${dueDate}"/>
			</if-compare>
		</if-not-empty>

		<make-value entity-name="FrPaymentPlan" value-field="newEntity"/>
		<sequenced-id sequence-name="FrPaymentPlan" field="paymentPlanSeqId"/>
		<set field="newEntity.paymentPlanId" value="PP${paymentPlanSeqId}"/>
		<set field="newEntity.taxInvoiceId" from-field="taxInvoice.taxInvoiceId"/>
		<set field="newEntity.partyId" from-field="taxInvoice.partyId"/>
		<set field="newEntity.dueDate" from-field="dueDate"/>
		<set field="newEntity.amount" from-field="taxInvoice.totalAmount"/>
		<set field="newEntity.statusId" value="FRPP_PLANNED"/>
		<create-value value-field="newEntity"/>

		<field-to-result field="newEntity.paymentPlanId" result-name="paymentPlanId"/>
		<field-to-result field="dueDate"/>
	</simple-method>

	<!-- 20210820 정해인 테스트용 -->
	<simple-method method-name="createFrPaymentPlanFromTaxInvoiceBak" short-description="매입 세금계산서 지급계획 생성">
		<entity-one entity-name="FrTaxInvoice" value-field="taxInvoice"/>
		<if-empty field="taxInvoice">
			<add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctTaxInvoiceNotFound"/></add-error>
			<check-errors/>
		</if-empty>
		<if-compare field="taxInvoice.taxInvoiceTypeEnumId" operator="not-equals" value="FRTI_PURCHASE">
			<add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctPaymentPlanPurchaseOnly"/></add-error>
			<check-errors/>
		</if-compare>

		<!-- A5 지급기일 = 발행일이 속한 달의 다음 달 말일
			 예) 2018-03-05 발행 → 2018-04-30, 2018-01-31 발행 → 2018-02-28
			 ※ 거래처별 지급일수(FrVendorPayTerm)는 아직 반영하지 않음 -->
		<set field="daysLater" value="0" type="Integer"/>
		<set field="monthsLater" value="1" type="Integer"/>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="toTimestamp" ret-field="issueStamp">
			<field field="taxInvoice.issueDate" type="java.util.Date"/>
		</call-class-method>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="getMonthStart" ret-field="nextMonthStart">
			<field field="issueStamp" type="java.sql.Timestamp"/>
			<field field="daysLater" type="int"/>
			<field field="monthsLater" type="int"/>
		</call-class-method>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="getMonthEnd" ret-field="nextMonthEnd">
			<field field="nextMonthStart" type="java.sql.Timestamp"/>
			<field field="timeZone" type="java.util.TimeZone"/>
			<field field="locale" type="java.util.Locale"/>
		</call-class-method>
		<call-class-method class-name="org.apache.ofbiz.base.util.UtilDateTime" method-name="toSqlDate" ret-field="dueDate">
			<field field="nextMonthEnd" type="java.util.Date"/>
		</call-class-method>

		<make-value entity-name="FrPaymentPlan" value-field="newEntity"/>
		<sequenced-id sequence-name="FrPaymentPlan" field="paymentPlanSeqId"/>
		<set field="newEntity.paymentPlanId" value="PP${paymentPlanSeqId}"/>
		<set field="newEntity.taxInvoiceId" from-field="taxInvoice.taxInvoiceId"/>
		<set field="newEntity.partyId" from-field="taxInvoice.partyId"/>
		<set field="newEntity.dueDate" from-field="dueDate"/>
		<set field="newEntity.amount" from-field="taxInvoice.totalAmount"/>
		<set field="newEntity.statusId" value="FRPP_PLANNED"/>
		<create-value value-field="newEntity"/>

		<field-to-result field="newEntity.paymentPlanId" result-name="paymentPlanId"/>
		<field-to-result field="dueDate"/>
	</simple-method>

	<simple-method method-name="completeFrPaymentPlan" short-description="지급완료 처리">
		<entity-one entity-name="FrPaymentPlan" value-field="paymentPlan"/>
		<if-empty field="paymentPlan">
			<add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctPaymentPlanNotFound"/></add-error>
			<check-errors/>
		</if-empty>
		<if-compare field="paymentPlan.statusId" operator="not-equals" value="FRPP_PLANNED">
			<add-error><fail-property resource="FrAcctErrorUiLabels" property="FrAcctPaymentPlanNotPlanned"/></add-error>
			<check-errors/>
		</if-compare>

		<if-empty field="parameters.paidDate">
			<now-timestamp field="parameters.paidDate"/>
		</if-empty>
		<set field="paymentPlan.statusId" value="FRPP_PAID"/>
		<set field="paymentPlan.paidDate" from-field="parameters.paidDate"/>
		<set field="paymentPlan.paidByUserLogin" from-field="userLogin.userLoginId"/>
		<set field="paymentPlan.comments" from-field="parameters.comments"/>
		<store-value value-field="paymentPlan"/>
	</simple-method>

