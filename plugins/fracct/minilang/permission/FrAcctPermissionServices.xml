<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성: 오픈브릿지시스템즈 김현석 / 2018.03.05 -->
<simple-methods xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Simple-Method" xsi:schemaLocation="http://ofbiz.apache.org/Simple-Method http://ofbiz.apache.org/dtds/simple-methods.xsd">

    <!-- 현업 사용자: FRACCT_VIEW 또는 FRACCT_ADMIN 이 있으면 통과 (전표 작성/수정/상신, 조회) -->
    <simple-method method-name="fracctUserPermissionCheck" short-description="FrAcct user permission check">
        <set field="hasPermission" type="Boolean" value="false"/>
        <if>
            <condition>
                <or>
                    <if-has-permission permission="FRACCT" action="_VIEW"/>
                    <if-has-permission permission="FRACCT" action="_ADMIN"/>
                </or>
            </condition>
            <then>
                <set field="hasPermission" type="Boolean" value="true"/>
            </then>
            <else>
                <property-to-field resource="FrAcctErrorUiLabels" property="FrAcctPermissionError" field="failMessage"/>
                <field-to-result field="failMessage"/>
            </else>
        </if>
        <field-to-result field="hasPermission"/>
    </simple-method>

